Algoritmo ejercicio_potencia
	// programa que solicite al usu dos valor numerico , el primero es la base y el segundo es el result, caclcule la potencia // 
	// primero elebar la base y calcular potencia // variable con el resultado de la potencia 
	Definir numeroBase Como Entero
	Definir numeroExponencial Como Entero
	Definir resultado Como Entero
	Escribir 'Escriba el primer numero'
	Leer numeroBase
	Escribir 'Escriba el numero exponencial'
	Leer numeroExponencial
	resultado <- numeroBase^numeroExponencial
	Escribir 'El resultado de la potencia es:', resultado
FinAlgoritmo
